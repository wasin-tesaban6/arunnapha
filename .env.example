# ===== จำเป็น (ตั้งใน Vercel → Settings → Environment Variables) =====
# สุ่มข้อความยาว ๆ อย่างน้อย 32 ตัวอักษร ใช้เข้ารหัส cookie การเข้าสู่ระบบ
AUTH_SECRET=

# ===== ฐานข้อมูล: Upstash Redis (Vercel → Storage → Upstash for Redis → Connect) =====
# Vercel จะเติมให้อัตโนมัติเมื่อกด Connect Project
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ===== ที่เก็บรูป: Vercel Blob (Vercel → Storage → Blob → Connect) — เติมอัตโนมัติ =====
BLOB_READ_WRITE_TOKEN=

# ===== ไม่บังคับ =====
# บัญชีแอดมินเริ่มต้น (ถ้าไม่ตั้ง จะใช้ Tesaban6 / CRMS6ARNAPHA)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# สร้าง/อัปเดตแอดมินหลายคนอัตโนมัติ (JSON, ตั้งเป็นแบบ Secret) — ระบบทำครั้งเดียวต่อค่าที่ตั้ง
# จัดการเพิ่มเติมได้ที่ /admin → ผู้ดูแลระบบ
# ADMIN_ACCOUNTS=[{"name":"ADMIN2nd","username":"admin2@example.com","password":"รหัสผ่านอย่างน้อย8ตัว"}]
ADMIN_ACCOUNTS=
# URL เว็บจริง (ใช้ในข้อความ LINE) เช่น https://sc-crms6-arunnapha.vercel.app
NEXT_PUBLIC_SITE_URL=

# ===== LINE Messaging API (ระบบแจ้งเตือนความคืบหน้า) =====
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Basic ID ของ LINE OA เช่น @123abcde
NEXT_PUBLIC_LINE_OA_ID=
# รหัสลับสำหรับให้แอดมิน/กลุ่มสภา ลงทะเบียนรับแจ้งเตือน (พิมพ์ "ADMIN <รหัสนี้>" ในแชต)
LINE_ADMIN_KEY=
